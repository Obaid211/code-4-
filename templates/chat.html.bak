<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chat - SmartAgri AI</title>
    <link rel="stylesheet" href="/static/css/chat.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <span class="logo-icon">🌾</span>
                <span>SmartAgri AI</span>
            </div>
            <ul class="nav-menu">
                <li><a href="index.html" class="nav-link">Dashboard</a></li>
                <li><a href="chat.html" class="nav-link active">Chat</a></li>
                <li><a href="analyzer.html" class="nav-link">Analyzer</a></li>
                <li><a href="market.html" class="nav-link">Market</a></li>
                <li><a href="profile.html" class="nav-link">Profile</a></li>
                <li><a href="about.html" class="nav-link">About</a></li>
                <li><a href="contact.html" class="nav-link">Contact</a></li>
            </ul>
            <div class="toolbar">
                <div class="language-selector">
                    <select id="chatLang" class="language-dropdown" aria-label="Chat language">
                        <option value="en">🌐 English</option>
                        <option value="hi">🌐 हिन्दी</option>
                        <option value="bn">🌐 বাংলা</option>
                    </select>
                </div>
                <button id="speakerToggle" class="speaker-toggle" title="Toggle Text-to-Speech" aria-label="Speaker toggle">
                    <svg class="speaker-icon" id="speakerIconOn" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path></svg>
                    <svg class="speaker-icon" id="speakerIconOff" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"></path></svg>
                </button>
            </div>
            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <main class="main-content">
        <div class="container chat-container">
            <header class="page-header">
                <div class="header-icon">🤖</div>
                <h1 class="header-title">AI Farm Assistant</h1>
                <p class="header-subtitle">Get instant farming advice powered by advanced AI</p>
            </header>

            <div class="faq-section">
                <div class="faq-header">
                    <span class="faq-icon">💡</span>
                    <h3 class="faq-title">Quick Questions</h3>
                </div>
                <div class="faq-container" id="faqContainer">
                    </div>
            </div>

            <div class="chat-interface">
                <div class="chat-wrapper">
                    <div class="chat-box" id="chatBox">
                        </div>
                    
                    <div class="typing-indicator" id="typingIndicator" style="display: none;">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>

                    <div class="location-bar" id="locationBar">
                        <span id="locationStatus">📍 Location: Not Set</span>
                        <button id="setLocationBtn" class="set-location-btn">Set Location</button>
                    </div>
                    <div class="chat-input-wrapper">
                        <button id="micBtn" class="icon-btn mic-btn" title="Record voice" aria-label="Microphone">
                            <svg class="mic-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1.2-9.1c0-.66.54-1.2 1.2-1.2.66 0 1.2.54 1.2 1.2l-.01 6.2c0 .66-.53 1.2-1.19 1.2-.66 0-1.2-.54-1.2-1.2V4.9zm6.5 6.1c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z"></path></svg>
                        </button>
                        <input 
                            type="text" 
                            id="chatInput" 
                            class="chat-input" 
                            placeholder="Ask about crops, weather, pests, fertilizer..."
                            aria-label="Chat message input"
                        >
                        <button id="sendBtn" class="send-button" aria-label="Send message">
                            <svg class="send-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2 .01 7z"></path></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h4>SmartAgri AI</h4>
                <p>Empowering farmers with AI-driven insights</p>
            </div>
            <div class="footer-section">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/">Dashboard</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Connect</h4>
                <ul>
                    <li><a href="#">Twitter</a></li>
                    <li><a href="#">LinkedIn</a></li>
                    <li><a href="#">Instagram</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2025 SmartAgri AI. All rights reserved.</p>
        </div>
    </footer>

    <script src="/static/js/chat.js"></script>
</body>
</html>